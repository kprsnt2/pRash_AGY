# Prash All-in-One Multi-Agent Chat Environment Variables
# You can set these for automatic defaults on Vercel or locally,
# OR enter/override them in the in-app Settings modal (stored securely in browser localStorage).

# 1. Primary Model: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-5.4-mini
# Alternative: gpt-5.4-nano, gpt-4o-mini, gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Backup 1 & Privacy Mode: Google Gemini (Zero-training paid key)
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-flash-latest
# Alternative: gemini-2.0-flash, gemini-flash-latest

# 3. Backup 2: NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_MODEL_DEFAULT=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 4. Backup 3: Groq Cloud (Ultra-fast failover)
GROQ_API_KEY=
GROQ_MODEL_DEFAULT=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
